    "migrate:sqlite": "node scripts/migrate-from-sqlite.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@cloudflare/workers-types": "^4.20250320.0",
    "pg": "^8.13.0",
    "sql.js": "^1.14.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  }
}
