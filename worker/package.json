{
  "name": "mynotes-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:d1": "wrangler d1 migrations apply mynotes-db --remote",
    "migrate:d1:local": "wrangler d1 migrations apply mynotes-db --local",
