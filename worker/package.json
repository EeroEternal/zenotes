{
  "name": "zenotes-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply zenotes-db --local && wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:d1": "wrangler d1 migrations apply zenotes-db --remote",
    "migrate:d1:local": "wrangler d1 migrations apply zenotes-db --local",
    "migrate:pg": "node scripts/migrate-from-postgres.mjs",
    "migrate:sqlite": "node scripts/migrate-from-sqlite.mjs",
    "d1:password": "node scripts/d1-set-password-sha256.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@cloudflare/workers-types": "^4.20250320.0",
    "pg": "^8.13.0",
    "sql.js": "^1.14.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@flue/sdk": "^0.3.10",
    "hash-wasm": "^4.12.0",
    "http-status-codes": "^2.3.0",
    "isomorphic-git": "^1.37.6",
    "memfs": "^4.57.2",
    "mime-types": "^3.0.2"
  }
}
